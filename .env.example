APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# La pantalla de primer inicio guarda estos valores localmente.
MT5_PATH=
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
